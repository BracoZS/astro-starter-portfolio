---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/site.config';

const tools = ['Java', 'Astro', 'React', 'Google Cloud', 'Linux', 'ITILv4'];
---

<BaseLayout title="About" description={`A bit about ${SITE.name} and how they work.`}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">About</p>

    <h1 class="font-display text-ink max-w-xl text-3xl font-medium sm:text-4xl">
      {SITE.role}.
    </h1>

    <div class="prose prose-sm sm:prose-base mt-8 max-w-xl">
      <p>
        Hello. I am an ex-musician, ex-soldier, current nerd. I'm very good at a couple of things,
        and okay at a whole bunch of others. I am interested in all things technology, science and
        philosophy. I realise that's a combination that would probably lead me to describe myself as
        a 'though leader' on instagram but I would rather not be a total wanker.
      </p>
      <p>
        When I'm not thinking, I'm probably asleep or walking my dog. He's a pretty radical creature
        and I wish more people were like him.
      </p>
      <p>
        My work tends to be involve technology and people problems, and is generally focussed on
        trying to get people to make fewer (and less) dumb decisions. I have experience in process
        development, technology operations management, service delivery and a whole bunch of other
        tech-related things, but what I find most enjoyable is helping people understand things and
        each-other.
      </p>
      <p>
        Fundamentally I love solving problems, and when I'm not working, or spending my time with
        loved ones, you will probably find me tinkering with something - either learning, building,
        or trying to figure out how something works.
      </p>
    </div>

    <div class="mt-10">
      <p class="text-ink-soft mb-3 font-mono text-xs tracking-[0.2em] uppercase">Tools</p>
      <ul class="flex flex-wrap gap-2">
        {
          tools.map((tool) => (
            <li class="border-line text-ink-soft rounded-full border px-3 py-1 font-mono text-xs">
              {tool}
            </li>
          ))
        }
      </ul>
    </div>

    <Button href={`mailto:${SITE.email}`} class="mt-10">Get in touch</Button>
  </section>
</BaseLayout>

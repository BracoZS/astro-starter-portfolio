---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogRow from '@/components/BlogRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';

const allBlog = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Blog" description="Notes and writing by Daniel Mallia.">
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <SectionHeading eyebrow="All posts" count={allBlog.length} />
    <div>
      {allBlog.map((entry) => <BlogRow entry={entry} />)}
    </div>
  </section>
</BaseLayout>
